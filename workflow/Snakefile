#############################
# Minimum Snakemake version #
#############################

# Enable setting a minimum Snakemake version supported by the workflow.
from snakemake.utils import min_version
min_version("8.0.0")


#################
# Configuration #
#################

configfile: "config/config.yaml"

#########
# Rules #
#########

rule all:
    run:
        print("BAM files:")
        for bam in config["bam_files"]:
            print(bam)
        
        print("GTF file:")
        print(config["gtf"])

